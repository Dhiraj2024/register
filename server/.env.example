# ==============================================================
# SERVER ENVIRONMENT VARIABLES (.env.example)
# ==============================================================
# Copy this file to .env and fill in your actual values:
# cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# IMPORTANT: Never commit the real .env file to Git!

# 1. MongoDB Atlas Connection URI
# Replace with your actual MongoDB connection string including username, password, and database name
#MONGO_URI=your_mongodb_atlas_connection_string

# 2. JWT Secret Key
# 'helloman' is a development-only placeholder. Replace with a long, random secret before production.
#JWT_SECRET=helloman

# 3. Admin Credentials
# Admin username used to log into the dashboard
#ADMIN_USERNAME=admin

# Bcrypt hash of your admin password.
# (Pre-filled below with the bcrypt hash for default development password: 'admin123')
# To generate a new hash for your own password, run: node utils/generateHash.js <yourPassword>
#ADMIN_PASSWORD_HASH=$2a$10$doDgUO8Dv6tAb0LvgAroQ.QxTqAolM6Ezy29gBt1Z/YYOnMg30wzK

# 4. Frontend Client URL for CORS
# In local development: http://localhost:5173
# In production on Vercel: https://your-frontend.vercel.app
#CLIENT_URL=http://localhost:5173

# 5. Local Server Port
#PORT=5000
